{
  "info": {
    "name": "MerchantPay API",
    "description": "Independent simulated payments demo. Set apiKey privately. No real payments or banking data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://merchantpay-production.up.railway.app"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "merchantId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Create merchant",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/merchants",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Shop\",\n  \"email\": \"demo@example.test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Created\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"merchantId\", pm.response.json().id);",
              "pm.collectionVariables.set(\"idempotencyKey\", \"demo-\" + pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read merchant",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/merchants/{{merchantId}}"
      }
    },
    {
      "name": "Create payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/payments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantId\": \"{{merchantId}}\",\n  \"amount\": 1299,\n  \"currency\": \"EUR\",\n  \"externalReference\": \"postman_demo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Created\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"paymentId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Replay payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/payments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantId\": \"{{merchantId}}\",\n  \"amount\": 1299,\n  \"currency\": \"EUR\",\n  \"externalReference\": \"postman_demo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Replayed\", () => pm.response.to.have.status(200));",
              "pm.test(\"Same payment\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"paymentId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "Conflict",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/payments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantId\": \"{{merchantId}}\",\n  \"amount\": 1300,\n  \"currency\": \"EUR\",\n  \"externalReference\": \"postman_demo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Conflict\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read payment",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/payments/{{paymentId}}"
      }
    },
    {
      "name": "List merchant payments",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/merchants/{{merchantId}}/payments?limit=20&offset=0"
      }
    }
  ]
}
